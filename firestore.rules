rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'adamu0533@gmail.com'
      );
    }

    function isAdmin() {
      return request.auth != null && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /admin_invites/{email} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.get('isAdmin', false) == false
                    && request.resource.data.get('isSuperAdmin', false) == false;
      allow update: if isSuperAdmin() || (
        request.auth != null && request.auth.uid == userId
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
        && request.resource.data.get('isSuperAdmin', false) == resource.data.get('isSuperAdmin', false)
      );
      allow delete: if isSuperAdmin();
    }

    match /community_reports/{reportId} {
      allow get, list: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.auth != null && request.resource.data.status == 'pending_review';
      allow update, delete: if isAdmin();
    }
  }
}

